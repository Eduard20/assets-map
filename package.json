{
  "name": "assets-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first, expandable map of asset managers, companies, investments and ownership.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/validate-data.mjs && node scripts/export-researched.mjs --check",
    "test:browser": "node tests/browser-smoke.mjs",
    "check:foundation": "node --test tests/foundation*.test.mjs",
    "build:site": "node scripts/prepare-site.mjs",
    "data:validate": "node scripts/foundation.mjs validate",
    "data:demo": "node scripts/foundation-demo.mjs",
    "data:export-researched": "node scripts/export-researched.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
